<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyVersion>3.13.3.0</AssemblyVersion>
    <FileVersion>3.13.3.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Les symboles de debogage ne sont pas lus par Jellyfin. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <!-- Le serveur fournit toutes les dépendances : le paquet ne doit contenir que notre assembly. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Sans cela, le glob implicite du SDK compilerait aussi tests/**, y compris les
         fichiers AssemblyInfo generes dans leurs dossiers obj. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Références de compilation uniquement : Jellyfin charge ses propres assemblys à l'exécution.
      Jellyfin.Data et Jellyfin.Database.Implementations arrivent transitivement mais sont déclarés
      explicitement pour que ExcludeAssets s'applique aussi à eux.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Data" Version="10.11.11">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="10.11.11">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    La documentation XML sert a faire respecter les commentaires a la compilation, mais
    n'a aucune utilite a l'execution : elle est retiree du dossier de sortie pour ne pas
    alourdir le paquet de moitie.
  -->
  <Target Name="RemoveDocumentationFromOutput" AfterTargets="CopyFilesToOutputDirectory">
    <Delete Files="$(OutDir)$(AssemblyName).xml" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\**\*.html" />
    <!-- Le script de la page d'accueil est servi par AssetsController depuis les ressources. -->
    <EmbeddedResource Include="Web\media-carousel.js" />
  </ItemGroup>

</Project>
